<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>dev.lunoralabs.pulso</groupId>
	<artifactId>pulso-spring-boot-starter</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<name>Pulso Spring Boot Starter</name>
	<description>Monitor your @Scheduled jobs with Pulso: one @Monitored annotation and you get an alert when a job stops running.</description>
	<url>https://github.com/lunoralabs-org/pulso_spring_boot_starter</url>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
		</license>
	</licenses>
	<developers>
		<developer>
			<name>Lunora Labs</name>
			<organization>Lunora Labs</organization>
			<organizationUrl>https://lunoralabs.dev</organizationUrl>
		</developer>
	</developers>
	<scm>
		<url>https://github.com/lunoralabs-org/pulso_spring_boot_starter</url>
		<connection>scm:git:https://github.com/lunoralabs-org/pulso_spring_boot_starter.git</connection>
	</scm>

	<properties>
		<!-- Java 17 bytecode: works on Spring Boot 3.5 and 4.x applications -->
		<maven.compiler.release>17</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Compiled and tested against the oldest supported line; CI also tests the newest (profile boot4) -->
		<spring-boot.version>3.5.16</spring-boot.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Always present in a Spring Boot application: its version is the application's -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- RestClient: also needed by apps that are not web apps -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
		</dependency>
		<!-- @Monitored is an aspect -->
		<dependency>
			<groupId>org.aspectj</groupId>
			<artifactId>aspectjweaver</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
				<configuration>
					<parameters>true</parameters>
					<annotationProcessorPaths>
						<path>
							<groupId>org.springframework.boot</groupId>
							<artifactId>spring-boot-configuration-processor</artifactId>
							<version>${spring-boot.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.6.1</version>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>boot4</id>
			<properties>
				<spring-boot.version>4.1.2</spring-boot.version>
			</properties>
		</profile>
	</profiles>
</project>
